{
  "name": "securitytrails-mcp",
  "version": "1.0.0",
  "description": "MCP server for the SecurityTrails API — DNS history, subdomain enumeration, WHOIS, SSL certificates and IP intelligence as tools for LLM agents.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "securitytrails",
    "osint",
    "dns",
    "subdomain-enumeration",
    "whois",
    "recon",
    "security"
  ],
  "homepage": "https://github.com/aqhmal/securitytrails-mcp#readme",
  "bugs": "https://github.com/aqhmal/securitytrails-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aqhmal/securitytrails-mcp.git"
  },
  "license": "MIT",
  "author": "aqhmal (https://github.com/aqhmal)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "securitytrails-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
